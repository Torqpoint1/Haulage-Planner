# Copy to .env.local and fill in. Never commit real keys.

# Supabase. For local development run `npx supabase start` and copy the API URL
# and publishable key from `npx supabase status`. Only the publishable key is ever
# used by the app; never put the secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the app, used in invitation links. Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map tiles (spec 4). MapTiler is the chosen provider: set its key and it's used.
# NEXT_PUBLIC_MAP_TILE_PROVIDER can force "stadia" or "none". The public
# OpenStreetMap tile servers must not be used in production.
NEXT_PUBLIC_MAP_TILE_PROVIDER=
NEXT_PUBLIC_MAP_TILE_KEY=

# Road distances (spec 4): OpenRouteService, HGV profile. Server-side only.
# Without a key the app uses straight-line distance × 1.3, labelled as an estimate.
ORS_API_KEY=
# ORS_API_URL=https://api.openrouteservice.org

# Serve the dev-only component gallery from a production build (used by Playwright).
# ENABLE_DEV_GALLERY=1

# Data protection (spec 12): links shown in Settings → Your data, and on sign-up,
# once the privacy notice and data processing terms are published.
PRIVACY_NOTICE_URL=
DATA_PROCESSING_TERMS_URL=

# Email (spec 4: Resend). Without these, invitations show a link to copy instead.
# Password reset emails come from Supabase Auth: point its SMTP at Resend in the
# hosted project's settings (see supabase/config.toml).
RESEND_API_KEY=
EMAIL_FROM="Haulage Planner <noreply@your-domain.example>"
# RESEND_API_URL=https://api.resend.com
# Who hears about deletion requests (Settings → Your data).
OPERATOR_EMAIL=
